{
  "name": "true-count",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/build-offline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "expo-mcp": "~0.2.4",
    "globals": "^17.12.0",
    "prettier": "3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
